# Переменные окружения проекта «АвтоГрад».
#
# Образец. Скопируйте в .env и подставьте настоящие значения:
#   cp .env.example .env
# Сам .env в репозиторий не попадает — он в .gitignore.
# Не копируйте его содержимое в issue, чат или скриншоты: токен бота
# и ключ модели дают полный доступ от вашего имени.
# Если токен всё-таки где-то засветился — отзовите его у @BotFather
# командой /revoke и выпустите новый.

# ─────────────────────────────────────────────────────────────
# Модель
# ─────────────────────────────────────────────────────────────

# Ключ OpenAI. Учебный контур работает на нём (ADR-0005).
OPENAI_API_KEY=sk-...

# Модель по умолчанию. Регрессы гоняем на mini, приёмку — на старшей.
AVTOGRAD_MODEL=gpt-5-mini

# Другой провайдер — две строки, а не правка кода (ADR-0005). У GigaChat и
# YandexGPT есть OpenAI-совместимый endpoint: укажите его адрес и ключ.
# Пусто — работаем с OpenAI по OPENAI_API_KEY.
AVTOGRAD_LLM_BASE=
AVTOGRAD_LLM_KEY=

# ─────────────────────────────────────────────────────────────
# Клиентский бот: продажи, найм, сервис в одной точке входа
# ─────────────────────────────────────────────────────────────

# Создать у @BotFather: /newbot → имя → username → токен сюда.
AVTOGRAD_CLIENT_BOT_TOKEN=123456:AA...

# ─────────────────────────────────────────────────────────────
# Внутренний бот: контур сотрудников — отпуск, справки, онбординг
# ─────────────────────────────────────────────────────────────

# Отдельный бот у @BotFather, не тот же самый.
AVTOGRAD_STAFF_BOT_TOKEN=123456:BB...

# Кому разрешён внутренний контур: числовые id через запятую.
# Пустое значение означает «никого» — бот будет молча отклонять всех.
# Свой id узнать: написать боту и посмотреть журнал запуска в консоли,
# там появится строка «обращение отклонено молча ... id 12345».
AVTOGRAD_STAFF_IDS=111111111,222222222

# ─────────────────────────────────────────────────────────────
# Консоль эскалаций: через неё человек забирает диалог у ассистента
# ─────────────────────────────────────────────────────────────

# Третий бот у @BotFather — отдельный от клиентского и внутреннего.
# Отдельный потому, что в карточке видны данные клиента, а кадровый
# канал таких данных носить не должен.
AVTOGRAD_OPS_BOT_TOKEN=

# Кому приходят карточки эскалаций: числовые id через запятую.
# Список свой, не тот, что у внутреннего бота: доступ к перепискам
# клиентов нужен дежурному и руководителям, а не всем сотрудникам.
AVTOGRAD_OPS_IDS=

# Через сколько минут молчания оператора диалог возвращается ассистенту.
# Клиент не должен оставаться в тишине, если человек отвлёкся.
AVTOGRAD_HOLD_MINUTES=30

# ─────────────────────────────────────────────────────────────
# HTTP-ядро (tools/api.py)
# ─────────────────────────────────────────────────────────────

# Ключ доступа к API. Без него сервис отвечает 503 на каждый запрос:
# точка приёма персональных данных без аутентификации хуже, чем её отсутствие.
AVTOGRAD_API_KEY=придумайте-длинную-строку

# Порт, на котором поднимается ядро. По умолчанию 8080.
AVTOGRAD_API_PORT=8080
