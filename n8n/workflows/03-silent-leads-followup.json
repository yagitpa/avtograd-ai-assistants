{
  "name": "03. Молчащие лиды — одно напоминание",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "t3",
      "name": "Каждый час",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "core",
              "name": "core",
              "value": "http://localhost:8080",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cfg",
      "name": "Настройки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Настройки').first().json.core }}/v1/cold/followups",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "hours",
              "value": "24"
            },
            {
              "name": "limit",
              "value": "50"
            }
          ]
        }
      },
      "id": "list",
      "name": "Кто замолчал",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "notes": "Возвращает ТОЛЬКО номера диалогов — ни имени, ни телефона (ADR-0002)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "fieldToSplitOut": "dialogs",
        "options": {}
      },
      "id": "split",
      "name": "По одному диалогу",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.core }}/v1/cold/followup/{{ $json.dialogs }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "nudge",
      "name": "Напомнить",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "notes": "Текст пишет ядро по шаблону. Повтор запроса второго сообщения не рождает",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Каждый час": {
      "main": [
        [
          {
            "node": "Настройки",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Настройки": {
      "main": [
        [
          {
            "node": "Кто замолчал",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Кто замолчал": {
      "main": [
        [
          {
            "node": "По одному диалогу",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "По одному диалогу": {
      "main": [
        [
          {
            "node": "Напомнить",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "АвтоГрад"
    }
  ]
}
