{
  "name": "02. Сток — тревога «фид протух»",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "t2",
      "name": "Каждые 30 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "core",
              "name": "core",
              "value": "http://127.0.0.1:8080",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cfg",
      "name": "Настройки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "127.0.0.1, а не localhost: Node разрешает localhost в IPv6 ::1, а ядро слушает IPv4 — соединение отвергается с EACCES",
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Настройки').first().json.core }}/v1/cold/stock",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "state",
      "name": "Свежесть стока",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.stale }}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if",
      "name": "Фид протух?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.core }}/v1/cold/digest/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "1"
            }
          ]
        }
      },
      "id": "digest",
      "name": "Сводка дежурным",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "notes": "Сводка содержит строку о протухшем стоке — отдельного текста не нужно",
      "notesInFlow": true
    }
  ],
  "connections": {
    "Каждые 30 минут": {
      "main": [
        [
          {
            "node": "Настройки",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Настройки": {
      "main": [
        [
          {
            "node": "Свежесть стока",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Свежесть стока": {
      "main": [
        [
          {
            "node": "Фид протух?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Фид протух?": {
      "main": [
        [
          {
            "node": "Сводка дежурным",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "АвтоГрад"
    }
  ]
}
